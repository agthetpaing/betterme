@page "/patient/resources/{Id:guid}"
@attribute [Authorize(Roles = "Patient")]
@inject IApiClient Api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(_resource?.Title ?? "Resource") â€” BetterMe</PageTitle>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_upgradeRequired)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-12 text-center">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:64px;" Color="Color.Warning" />
        <MudText Typo="Typo.h5" Class="mt-4">Premium Resource</MudText>
        <MudText Color="Color.Secondary" Class="mt-2">Upgrade to Premium to access this resource and many more.</MudText>
        <MudButton Href="/subscription" Variant="Variant.Filled" Color="Color.Warning" Size="Size.Large" Class="mt-6">
            Upgrade Now
        </MudButton>
        <MudButton Href="/patient/resources" Variant="Variant.Text" Color="Color.Default" Class="mt-2 ml-2">
            Back to Library
        </MudButton>
    </MudContainer>
}
else if (_resource != null)
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudPaper Elevation="1" Class="pa-8" Style="border-radius:16px;">
        <div class="d-flex align-center gap-3 mb-4">
            <MudChip Color="@GetTypeColor(_resource.Type)" Variant="Variant.Filled">@_resource.Type</MudChip>
            @foreach (var tag in _resource.Tags)
            {
                <MudChip Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
            }
        </div>

        <MudText Typo="Typo.h4" Style="font-weight:700;">@_resource.Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            By @_resource.AuthorName â€” @_resource.CreatedAt.ToString("MMMM dd, yyyy")
        </MudText>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.body1" Style="line-height:1.8;">
            @_resource.Description
        </MudText>

        @if (!string.IsNullOrEmpty(_resource.ContentUrl))
        {
            <MudDivider Class="my-6" />

            @if (_resource.Type == ResourceType.Video)
            {
                <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px;">
                    <iframe src="@_resource.ContentUrl" style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;" allowfullscreen></iframe>
                </div>
            }
            else
            {
                <MudButton Href="@_resource.ContentUrl" Target="_blank" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.OpenInNew" Size="Size.Large">
                    @(_resource.Type == ResourceType.Article ? "Read Full Article" : "Download Exercise")
                </MudButton>
            }
        }
    </MudPaper>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ResourceDto? _resource;
    private bool _loading = true;
    private bool _upgradeRequired;
    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _resource = await Api.GetResourceAsync(Id);
            _breadcrumbs = new()
            {
                new("Resources", "/patient/resources"),
                new(_resource?.Title ?? "Detail", null, disabled: true)
            };
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _upgradeRequired = true;
        }
        catch
        {
            Snackbar.Add("Failed to load resource.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Color GetTypeColor(ResourceType type) => type switch
    {
        ResourceType.Article => Color.Primary,
        ResourceType.Video => Color.Error,
        ResourceType.Exercise => Color.Secondary,
        _ => Color.Default
    };
}
