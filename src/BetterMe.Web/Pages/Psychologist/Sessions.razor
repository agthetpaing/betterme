@page "/psych/sessions"
@attribute [Authorize(Roles = "Psychologist,Admin")]
@inject IApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Sessions â€” BetterMe</PageTitle>

<MudText Typo="Typo.h5" Class="page-title">Sessions</MudText>
<MudText Class="page-subtitle">Manage your patient appointments</MudText>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="false" PanelClass="pt-4">

        @* Pending â€” needs action *@
        <MudTabPanel Text="Pending Requests" BadgeData="@_pending.Count" BadgeColor="Color.Warning">
            @if (!_pending.Any())
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">All caught up! No pending requests.</MudAlert>
            }
            else
            {
                <MudGrid>
                    @foreach (var s in _pending)
                    {
                        <MudItem xs="12" md="6">
                            <MudCard Elevation="2" Style="border-radius:12px;border-left:4px solid #f59e0b;">
                                <MudCardContent Class="pa-4">
                                    <div class="d-flex align-center gap-3 mb-2">
                                        <MudAvatar Color="Color.Warning" Size="Size.Medium">
                                            @s.PatientName.Split(' ').FirstOrDefault()?[0]
                                        </MudAvatar>
                                        <div>
                                            <MudText Style="font-weight:600;">@s.PatientName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                                                @s.ScheduledAt.ToLocalTime().ToString("dddd, MMMM d Â· h:mm tt") Â· @s.DurationMinutes min
                                            </MudText>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(s.PatientNotes))
                                    {
                                        <MudPaper Elevation="0" Class="pa-3 mt-2" Style="background:#f9fafb;border-radius:8px;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Patient notes:</b></MudText>
                                            <MudText Typo="Typo.body2">@s.PatientNotes</MudText>
                                        </MudPaper>
                                    }
                                </MudCardContent>
                                <MudCardActions Class="pa-3 gap-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Check"
                                               OnClick="() => OpenConfirmDialog(s)">
                                        Confirm
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Close"
                                               OnClick="() => DeclineSession(s.Id)">
                                        Decline
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudTabPanel>

        @* Upcoming (Confirmed) *@
        <MudTabPanel Text="Upcoming" BadgeData="@_upcoming.Count" BadgeColor="Color.Success">
            @if (!_upcoming.Any())
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No upcoming sessions confirmed yet.</MudAlert>
            }
            else
            {
                <MudGrid>
                    @foreach (var s in _upcoming)
                    {
                        <MudItem xs="12" md="6">
                            <MudCard Elevation="1" Style="border-radius:12px;border-left:4px solid #2E8B7A;">
                                <MudCardContent Class="pa-4">
                                    <div class="d-flex align-center gap-3 mb-2">
                                        <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                            @s.PatientName.Split(' ').FirstOrDefault()?[0]
                                        </MudAvatar>
                                        <div>
                                            <MudText Style="font-weight:600;">@s.PatientName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @s.ScheduledAt.ToLocalTime().ToString("dddd, MMMM d Â· h:mm tt") Â· @s.DurationMinutes min
                                            </MudText>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(s.MeetingUrl))
                                    {
                                        <MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Class="mt-1">
                                            <MudIcon Icon="@Icons.Material.Filled.VideoCall" Size="Size.Small" Class="mr-1" />
                                            Meeting link set
                                        </MudChip>
                                    }
                                </MudCardContent>
                                <MudCardActions Class="pa-3 gap-2">
                                    @if (!string.IsNullOrEmpty(s.MeetingUrl))
                                    {
                                        <MudButton Href="@s.MeetingUrl" Target="_blank"
                                                   Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.VideoCall">
                                            Join
                                        </MudButton>
                                    }
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                               OnClick="() => OpenCompleteDialog(s)">
                                        Mark Complete
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                               OnClick="() => CancelSession(s.Id)">
                                        Cancel
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudTabPanel>

        @* Past *@
        <MudTabPanel Text="Past">
            @if (!_past.Any())
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No past sessions yet.</MudAlert>
            }
            else
            {
                <MudGrid>
                    @foreach (var s in _past)
                    {
                        <MudItem xs="12" md="6">
                            <SessionCard Session="s" ShowPatientName="true" />
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudTabPanel>

    </MudTabs>
}

@* Confirm dialog *@
@if (_confirmingSession != null)
{
    <MudDialog @bind-IsVisible="_showConfirmDialog" Options='new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }'>
        <TitleContent><MudText Typo="Typo.h6">Confirm Session</MudText></TitleContent>
        <DialogContent>
            <MudText Class="mb-4">
                Confirming session with <b>@_confirmingSession.PatientName</b> on
                @_confirmingSession.ScheduledAt.ToLocalTime().ToString("MMM d 'at' h:mm tt").
            </MudText>
            <MudTextField @bind-Value="_meetingUrl" Label="Meeting Link (Zoom / Teams / Google Meet)"
                          Variant="Variant.Outlined" FullWidth="true"
                          Placeholder="https://zoom.us/j/..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.VideoCall" />
            <MudTextField @bind-Value="_psychNotes" Label="Notes for patient (optional)"
                          Variant="Variant.Outlined" Lines="2" FullWidth="true" Class="mt-3" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _showConfirmDialog = false">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Disabled="string.IsNullOrWhiteSpace(_meetingUrl) || _submitting"
                       OnClick="ConfirmSession">
                @if (_submitting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Confirm & Send Link
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@* Complete dialog *@
@if (_completingSession != null)
{
    <MudDialog @bind-IsVisible="_showCompleteDialog" Options='new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }'>
        <TitleContent><MudText Typo="Typo.h6">Mark Session Complete</MudText></TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="_sessionNotes" Label="Session notes (optional)"
                          Variant="Variant.Outlined" Lines="3" FullWidth="true"
                          HelperText="Private notes â€” only visible to you" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _showCompleteDialog = false">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CompleteSession">
                Mark Complete
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private List<SessionDto> _all = new();
    private List<SessionDto> _pending => _all.Where(s => s.Status == SessionStatus.Pending).OrderBy(s => s.ScheduledAt).ToList();
    private List<SessionDto> _upcoming => _all.Where(s => s.Status == SessionStatus.Confirmed && s.ScheduledAt > DateTime.UtcNow).OrderBy(s => s.ScheduledAt).ToList();
    private List<SessionDto> _past => _all.Where(s => s.Status is SessionStatus.Completed or SessionStatus.Canceled or SessionStatus.Declined).OrderByDescending(s => s.ScheduledAt).ToList();

    private bool _loading = true;
    private bool _submitting;

    private SessionDto? _confirmingSession;
    private bool _showConfirmDialog;
    private string? _meetingUrl;
    private string? _psychNotes;

    private SessionDto? _completingSession;
    private bool _showCompleteDialog;
    private string? _sessionNotes;

    protected override async Task OnInitializedAsync()
    {
        try { _all = await Api.GetSessionsAsync(); }
        catch { Snackbar.Add("Could not load sessions.", Severity.Error); }
        finally { _loading = false; }
    }

    private void OpenConfirmDialog(SessionDto s)
    {
        _confirmingSession = s;
        _meetingUrl = null;
        _psychNotes = null;
        _showConfirmDialog = true;
    }

    private async Task ConfirmSession()
    {
        if (_confirmingSession == null || string.IsNullOrWhiteSpace(_meetingUrl)) return;
        _submitting = true;
        try
        {
            await Api.ConfirmSessionAsync(_confirmingSession.Id, new ConfirmSessionRequest
            {
                MeetingUrl = _meetingUrl,
                PsychologistNotes = _psychNotes
            });
            var s = _all.First(x => x.Id == _confirmingSession.Id);
            s.Status = SessionStatus.Confirmed;
            s.MeetingUrl = _meetingUrl;
            _showConfirmDialog = false;
            Snackbar.Add("Session confirmed and meeting link sent!", Severity.Success);
        }
        catch { Snackbar.Add("Failed to confirm session.", Severity.Error); }
        finally { _submitting = false; }
    }

    private async Task DeclineSession(Guid id)
    {
        var confirmed = await DialogService.ShowMessageBox("Decline Session", "Are you sure you want to decline this session request?", "Yes, decline", cancelText: "Cancel");
        if (confirmed != true) return;

        try
        {
            await Api.DeclineSessionAsync(id);
            var s = _all.First(x => x.Id == id);
            s.Status = SessionStatus.Declined;
            Snackbar.Add("Session declined.", Severity.Info);
        }
        catch { Snackbar.Add("Failed to decline session.", Severity.Error); }
    }

    private void OpenCompleteDialog(SessionDto s)
    {
        _completingSession = s;
        _sessionNotes = null;
        _showCompleteDialog = true;
    }

    private async Task CompleteSession()
    {
        if (_completingSession == null) return;
        try
        {
            await Api.CompleteSessionAsync(_completingSession.Id, _sessionNotes);
            var s = _all.First(x => x.Id == _completingSession.Id);
            s.Status = SessionStatus.Completed;
            _showCompleteDialog = false;
            Snackbar.Add("Session marked as complete.", Severity.Success);
        }
        catch { Snackbar.Add("Failed to mark complete.", Severity.Error); }
    }

    private async Task CancelSession(Guid id)
    {
        var confirmed = await DialogService.ShowMessageBox("Cancel Session", "Cancel this session?", "Yes, cancel", cancelText: "Keep");
        if (confirmed != true) return;

        try
        {
            await Api.CancelSessionAsync(id);
            var s = _all.First(x => x.Id == id);
            s.Status = SessionStatus.Canceled;
            Snackbar.Add("Session cancelled.", Severity.Info);
        }
        catch { Snackbar.Add("Failed to cancel session.", Severity.Error); }
    }
}
