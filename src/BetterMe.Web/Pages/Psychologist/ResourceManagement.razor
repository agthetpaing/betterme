@page "/psych/resources"
@attribute [Authorize(Roles = "Psychologist,Admin")]
@inject IApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Manage Resources â€” BetterMe</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="page-title">Resource Management</MudText>
        <MudText Class="page-subtitle" Style="margin-bottom:0;">Create and manage mental health resources</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        New Resource
    </MudButton>
</div>

<MudPaper Elevation="1" Style="border-radius:12px;">
    <MudTable Items="@_resources" Dense="true" Hover="true" Loading="_loading" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Tier</MudTh>
            <MudTh>Published</MudTh>
            <MudTh>Tags</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title" Style="max-width:250px;">
                <MudText Typo="Typo.body2" Style="font-weight:600;">@context.Title</MudText>
            </MudTd>
            <MudTd DataLabel="Type">
                <MudChip Color="@GetTypeColor(context.Type)" Size="Size.Small" Variant="Variant.Filled">@context.Type</MudChip>
            </MudTd>
            <MudTd DataLabel="Tier">
                @if (context.RequiredTier == SubscriptionTier.Premium)
                {
                    <span class="tier-badge-premium">Premium</span>
                }
                else
                {
                    <span class="tier-badge-free">Free</span>
                }
            </MudTd>
            <MudTd DataLabel="Published">
                <MudSwitch T="bool" Value="context.IsPublished" Color="Color.Success"
                           ValueChanged="@(v => TogglePublish(context, v))" />
            </MudTd>
            <MudTd DataLabel="Tags">
                @foreach (var tag in context.Tags.Take(2))
                {
                    <MudChip Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                }
                @if (context.Tags.Count > 2)
                {
                    <MudText Typo="Typo.caption">+@(context.Tags.Count - 2)</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToString("MMM dd")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DeleteResource(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Align="Align.Center" Color="Color.Secondary" Class="pa-6">
                No resources yet. Click "New Resource" to create your first one.
            </MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@if (_totalPages > 1)
{
    <div class="d-flex justify-center mt-6">
        <MudPagination Count="@_totalPages" Selected="@_page" SelectedChanged="PageChanged" Color="Color.Primary" />
    </div>
}

@code {
    private List<ResourceDto> _resources = new();
    private List<ResourceTagDto> _tags = new();
    private int _page = 1;
    private int _totalPages;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var tagsTask = Api.GetTagsAsync();
        await LoadResources();
        _tags = await tagsTask;
    }

    private async Task LoadResources()
    {
        _loading = true;
        try
        {
            var result = await Api.GetResourcesAsync(page: _page, pageSize: 20);
            _resources = result.Items;
            _totalPages = result.TotalPages;
        }
        catch { Snackbar.Add("Failed to load resources.", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task PageChanged(int page)
    {
        _page = page;
        await LoadResources();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ResourceDialog>
        {
            { x => x.Model, new CreateResourceRequest() },
            { x => x.Tags, _tags },
            { x => x.IsNew, true }
        };
        var dialog = await DialogService.ShowAsync<ResourceDialog>("New Resource", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateResourceRequest req)
        {
            var created = await Api.CreateResourceAsync(req);
            if (created != null)
            {
                Snackbar.Add("Resource created!", Severity.Success);
                await LoadResources();
            }
        }
    }

    private async Task OpenEditDialog(ResourceDto resource)
    {
        var model = new CreateResourceRequest
        {
            Title = resource.Title,
            Description = resource.Description,
            ContentUrl = resource.ContentUrl,
            ThumbnailUrl = resource.ThumbnailUrl,
            Type = resource.Type,
            RequiredTier = resource.RequiredTier,
            IsPublished = resource.IsPublished,
            TagSlugs = resource.Tags.Select(t => t.ToLowerInvariant().Replace(" ", "-")).ToList()
        };

        var parameters = new DialogParameters<ResourceDialog>
        {
            { x => x.Model, model },
            { x => x.Tags, _tags },
            { x => x.IsNew, false }
        };
        var dialog = await DialogService.ShowAsync<ResourceDialog>("Edit Resource", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateResourceRequest req)
        {
            await Api.UpdateResourceAsync(resource.Id, req);
            Snackbar.Add("Resource updated!", Severity.Success);
            await LoadResources();
        }
    }

    private async Task TogglePublish(ResourceDto resource, bool publish)
    {
        var req = new CreateResourceRequest
        {
            Title = resource.Title,
            Description = resource.Description,
            ContentUrl = resource.ContentUrl,
            ThumbnailUrl = resource.ThumbnailUrl,
            Type = resource.Type,
            RequiredTier = resource.RequiredTier,
            IsPublished = publish,
            TagSlugs = resource.Tags.Select(t => t.ToLowerInvariant().Replace(" ", "-")).ToList()
        };
        await Api.UpdateResourceAsync(resource.Id, req);
        resource.IsPublished = publish;
        Snackbar.Add(publish ? "Resource published." : "Resource unpublished.", Severity.Info);
    }

    private async Task DeleteResource(ResourceDto resource)
    {
        var confirm = await DialogService.ShowMessageBox("Delete Resource",
            $"Are you sure you want to delete \"{resource.Title}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirm == true)
        {
            await Api.DeleteResourceAsync(resource.Id);
            Snackbar.Add("Resource deleted.", Severity.Warning);
            await LoadResources();
        }
    }

    private Color GetTypeColor(ResourceType type) => type switch
    {
        ResourceType.Article => Color.Primary,
        ResourceType.Video => Color.Error,
        ResourceType.Exercise => Color.Secondary,
        _ => Color.Default
    };
}
